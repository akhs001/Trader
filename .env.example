# Copy this file to ".env" (same folder) and fill in your details.
# The .env file stays on your computer; it is never uploaded to GitHub.

# Only needed if you set the price source to "twelvedata" in the settings.
# TWELVE_DATA_API_KEY=paste-your-key-here

# The Gmail address that sends the alerts.
GMAIL_ADDRESS=you@gmail.com

# A Gmail app password (16 letters), NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Optional: send the alerts to a different address.
# ALERT_TO=someone@example.com

# --- Only when Trader runs on a hosting service (see README, "Running in the cloud") ---
# These are set as variables on the host, not in this file.
# TRADER_PASSWORD=a-long-password      (required there; the page asks for it)
# TRADER_DATA_DIR=/data                (where the watchlist and settings are kept)
# RESEND_API_KEY=re_...                (email through Resend instead of Gmail)
# ALERT_FROM=Trader <alerts@yourdomain.com>
