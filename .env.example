# Copy this file to ".env" (same folder) and fill in your details.
# The .env file stays on your computer; it is never uploaded to GitHub.

# The Gmail address that sends the alerts.
GMAIL_ADDRESS=you@gmail.com

# A Gmail app password (16 letters), NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Optional: send the alerts to a different address.
# ALERT_TO=someone@example.com
